# ---------------------------------------------------------------------------
# Copy this file to .env.local and paste your keys there.
# .env.local is gitignored and never leaves this machine.
# Never paste a key into a chat message — it is exposed the moment it is typed.
# ---------------------------------------------------------------------------

# LLM gateway — powers the chat pane. Anything OpenAI-compatible works.
# Easiest path is the Connect button in the app header; these are the fallback.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=auto/best-coding

# GitHub — only needed to open a pull request from the app.
# Fine-grained token, Contents + Pull requests = write, on the target repo.
GITHUB_TOKEN=
